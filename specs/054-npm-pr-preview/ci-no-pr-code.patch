From e8334ca093a9945080db5ea10cf79444141bcde5 Mon Sep 17 00:00:00 2001
From: alkampferoutlook <alkampferoutlook@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:08:42 +0000
Subject: [PATCH] fix(ci): publish the PR run's tarball; manual preview runs no
 PR code

CodeQL actions/cache-poisoning/poisonable-step (alerts 6-8): a
workflow_dispatch run executes in the default branch's cache scope, so
building PR code there could poison that cache. The pull_request run now
packs and uploads the preview tarball; the manual run finds the successful
pull_request run of the PR head, skips build/integration-tests, and only
re-versions (tar + node) and publishes that artifact.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/ci.yml | 122 +++++++++++++++++++--------------------
 1 file changed, 59 insertions(+), 63 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index e34c358..c1eaa53 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,22 +14,24 @@ on:
 
 jobs:
   # Trusted gate for a manual preview run. Runs only code from the dispatched
-  # ref (never the PR), validates the PR, pins its head SHA so every later job
-  # builds exactly the same commit, and derives the version from tags.
+  # ref (never the PR): validates the PR, finds the successful `pull_request`
+  # CI run of its head commit (whose tarball gets published), and derives the
+  # version from tags. The manual run never executes PR code.
   prepare:
+    if: github.event_name == 'workflow_dispatch' && inputs.pr != ''
     runs-on: ubuntu-latest
     permissions:
       contents: read
       pull-requests: read
+      actions: read
     outputs:
-      sha: ${{ steps.pr.outputs.sha }}
+      run_id: ${{ steps.pr.outputs.run_id }}
       version: ${{ steps.version.outputs.version }}
       tag: ${{ steps.version.outputs.tag }}
 
     steps:
-      - name: Check PR is open
+      - name: Check PR is open and tested
         id: pr
-        if: inputs.pr != ''
         env:
           GH_TOKEN: ${{ github.token }}
           PR: ${{ inputs.pr }}
@@ -41,17 +43,22 @@ jobs:
           if [ "$state" != "OPEN" ]; then
             echo "PR #$PR is $state, nothing to publish"; exit 1
           fi
-          echo "sha=$(gh pr view "$PR" -R "$GITHUB_REPOSITORY" --json headRefOid -q .headRefOid)" >> "$GITHUB_OUTPUT"
+          sha=$(gh pr view "$PR" -R "$GITHUB_REPOSITORY" --json headRefOid -q .headRefOid)
+          run_id=$(gh run list -R "$GITHUB_REPOSITORY" --workflow ci.yml --event pull_request \
+            --commit "$sha" --status success --limit 1 --json databaseId -q '.[0].databaseId')
+          if [ -z "$run_id" ]; then
+            echo "No successful pull_request CI run for PR #$PR head $sha; wait for it or re-run it"; exit 1
+          fi
+          echo "Publishing the tarball of CI run $run_id (PR #$PR, $sha)"
+          echo "run_id=$run_id" >> "$GITHUB_OUTPUT"
 
       - uses: actions/checkout@v4
-        if: inputs.pr != ''
         with:
           fetch-depth: 0
           fetch-tags: true
 
       - name: Compute preview version
         id: version
-        if: inputs.pr != ''
         env:
           PR: ${{ inputs.pr }}
         run: |
@@ -60,7 +67,7 @@ jobs:
           echo "$out" | tee -a "$GITHUB_OUTPUT"
 
   build:
-    needs: prepare
+    if: inputs.pr == ''
     runs-on: ubuntu-latest
     permissions:
       contents: read
@@ -69,16 +76,13 @@ jobs:
     steps:
       - uses: actions/checkout@v4
         with:
-          ref: ${{ needs.prepare.outputs.sha }}
           fetch-depth: 0
           fetch-tags: true
 
-      # No npm cache on a preview run: it executes PR code, which must not be
-      # able to write a cache that later default-branch runs restore.
       - uses: actions/setup-node@v4
         with:
           node-version: lts/*
-          cache: ${{ inputs.pr == '' && 'npm' || '' }}
+          cache: npm
 
       - run: npm ci
 
@@ -99,25 +103,37 @@ jobs:
           path: test-results/unit.xml
           reporter: java-junit
 
+      # The tarball a later manual preview run publishes. Built here, in the
+      # unprivileged pull_request run, so the manual run never executes PR code.
+      - name: Pack preview tarball
+        if: github.event_name == 'pull_request'
+        run: mkdir -p preview && npm pack --ignore-scripts --pack-destination preview
+
+      - uses: actions/upload-artifact@v4
+        if: github.event_name == 'pull_request'
+        with:
+          name: preview-tarball
+          path: preview/*.tgz
+          if-no-files-found: error
+          retention-days: 30
+
   integration-tests:
-    needs: prepare
     runs-on: ubuntu-latest
     permissions:
       contents: read
       checks: write
-    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
+    if: inputs.pr == '' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
 
     steps:
       - uses: actions/checkout@v4
         with:
-          ref: ${{ needs.prepare.outputs.sha }}
           fetch-depth: 0
           fetch-tags: true
 
       - uses: actions/setup-node@v4
         with:
           node-version: lts/*
-          cache: ${{ inputs.pr == '' && 'npm' || '' }}
+          cache: npm
 
       - run: npm ci
 
@@ -181,74 +197,54 @@ jobs:
         run: npm publish --tag "${{ steps.version.outputs.tag }}" --provenance --access public
 
   # Preview of a pull request, started by hand (workflow_dispatch with `pr`).
-  # Split in two so the job holding the npm publish permission never executes
-  # PR code: `package-preview` runs the PR's scripts without id-token and hands
-  # over a tarball; `publish-preview` only publishes that tarball.
-  package-preview:
-    needs: [prepare, build, integration-tests]
-    if: github.event_name == 'workflow_dispatch' && inputs.pr != ''
-    runs-on: ubuntu-latest
-    permissions:
-      contents: read
-
-    steps:
-      - uses: actions/checkout@v4
-        with:
-          ref: ${{ needs.prepare.outputs.sha }}
-
-      # No npm cache (cache poisoning) and no lifecycle scripts: the build is
-      # plain tsup, so install and pack need none of the PR's scripts.
-      - uses: actions/setup-node@v4
-        with:
-          node-version: lts/*
-
-      - run: npm ci --ignore-scripts
-
-      - run: npm run build
-
-      - name: Pack preview
-        env:
-          VERSION: ${{ needs.prepare.outputs.version }}
-        run: |
-          npm pkg set version="$VERSION"
-          mkdir -p preview && npm pack --ignore-scripts --pack-destination preview
-
-      - uses: actions/upload-artifact@v4
-        with:
-          name: preview-tarball
-          path: preview/*.tgz
-          if-no-files-found: error
-
+  # Publishes the tarball that the PR's own `pull_request` run built and
+  # tested; no PR code runs here. The tarball is only listed, extracted to a
+  # temp dir, re-versioned and re-packed with tar and node, then published.
   publish-preview:
-    needs: [prepare, package-preview]
-    if: github.event_name == 'workflow_dispatch' && inputs.pr != ''
+    needs: prepare
     runs-on: ubuntu-latest
     permissions:
+      actions: read
       id-token: write
 
     steps:
       - uses: actions/download-artifact@v4
         with:
           name: preview-tarball
-          path: preview
+          path: ${{ runner.temp }}/preview
+          run-id: ${{ needs.prepare.outputs.run_id }}
+          github-token: ${{ github.token }}
 
       - uses: actions/setup-node@v4
         with:
           node-version: lts/*
           registry-url: https://registry.npmjs.org
 
-      - name: Verify tarball
+      - name: Re-version tarball
+        working-directory: ${{ runner.temp }}/preview
         env:
           VERSION: ${{ needs.prepare.outputs.version }}
         run: |
-          [ "$(ls preview/*.tgz | wc -l)" = 1 ]
-          [ "$(tar -xzOf preview/*.tgz package/package.json | node -p 'JSON.parse(require("fs").readFileSync(0)).name')" = azdo-cli ]
-          [ "$(tar -xzOf preview/*.tgz package/package.json | node -p 'JSON.parse(require("fs").readFileSync(0)).version')" = "$VERSION" ]
+          [ "$(ls *.tgz | wc -l)" = 1 ]
+          # Only plain files and directories under package/: no links, no "..".
+          tar -tvzf *.tgz | awk '$1 !~ /^[-d]/ { print; bad=1 } END { exit bad }'
+          tar -tzf *.tgz | grep -Ev '^package/' && exit 1
+          tar -tzf *.tgz | grep -E '(^|/)\.\.(/|$)' && exit 1
+          mkdir out && tar -xzf *.tgz -C out --no-same-owner --no-same-permissions
+          node -e '
+            const fs = require("fs"); const f = "out/package/package.json";
+            const p = JSON.parse(fs.readFileSync(f));
+            if (p.name !== "azdo-cli") throw new Error("unexpected package name " + p.name);
+            p.version = process.env.VERSION; delete p.publishConfig;
+            fs.writeFileSync(f, JSON.stringify(p, null, 2) + "\n");'
+          tar -czf "azdo-cli-$VERSION.tgz" -C out package
 
       - name: Publish preview to npm
+        working-directory: ${{ runner.temp }}/preview
         env:
+          VERSION: ${{ needs.prepare.outputs.version }}
           TAG: ${{ needs.prepare.outputs.tag }}
-        run: npm publish preview/*.tgz --registry https://registry.npmjs.org/ --tag "$TAG" --provenance --access public
+        run: npm publish "azdo-cli-$VERSION.tgz" --ignore-scripts --registry https://registry.npmjs.org/ --tag "$TAG" --provenance --access public
 
       - name: Summary
         env:
-- 
