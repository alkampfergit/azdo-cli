From 52b6e63cbe8101babef8507ceefdfcc0620fad1b Mon Sep 17 00:00:00 2001
From: alkampferoutlook <alkampferoutlook@users.noreply.github.com>
Date: Tue, 6 Oct 2026 13:05:43 +0000
Subject: [PATCH] fix(ci): drop setup-node from package-preview (CodeQL
 cache-poisoning)

---
 .github/workflows/ci.yml | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index e34c358..fce240c 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -196,12 +196,9 @@ jobs:
         with:
           ref: ${{ needs.prepare.outputs.sha }}
 
-      # No npm cache (cache poisoning) and no lifecycle scripts: the build is
-      # plain tsup, so install and pack need none of the PR's scripts.
-      - uses: actions/setup-node@v4
-        with:
-          node-version: lts/*
-
+      # No setup-node (CodeQL treats it as a cache-writing step even without
+      # `cache:`; the runner's preinstalled Node is enough for tsup) and no
+      # lifecycle scripts: install and pack need none of the PR's scripts.
       - run: npm ci --ignore-scripts
 
       - run: npm run build
-- 
2.47.3

